<?xml version="1.0" encoding="utf-8"?>
<!-- The app's header gradient, so the window opens on the same picture the
     Flutter splash screen paints. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#FFE7C2D2"
        android:centerColor="#FFB9C9E3"
        android:endColor="#FFF1D8C6"
        android:type="linear" />
</shape>
